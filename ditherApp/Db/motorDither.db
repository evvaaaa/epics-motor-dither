record(dither, "$(P):DITHER") {
    field(DESC, "Motor dithering")
    field(SCAN, ".1 second")
    field(PREC, "$(PREC=4)")
    field(MSTP, "$(MOTOR=$(P)).STOP PP")
    field(MVAL, "$(MOTOR=$(P)).VAL PP")
    field(MVEL, "$(MOTOR=$(P)).VELO NPP")
    field(MVBS, "$(MOTOR=$(P)).VBAS NPP")
    field(MVMX, "$(MOTOR=$(P)).VMAX NPP")
    field(MDMV, "$(MOTOR=$(P)).DMOV NPP")
    field(MMVN, "$(MOTOR=$(P)).MOVN NPP")
    field(MLLM, "$(MOTOR=$(P)).LLM NPP")
    field(MHLM, "$(MOTOR=$(P)).HLM NPP")
    field(MDLL, "$(MOTOR=$(P)).DLLM NPP")
    field(MDHL, "$(MOTOR=$(P)).DHLM NPP")
    field(MMST, "$(MOTOR=$(P)).MSTA NPP")
    field(MSET, "$(MOTOR=$(P)).SET NPP")
    field(MSPM, "$(MOTOR=$(P)).SPMG NPP")
    field(MLVI, "$(MOTOR=$(P)).LVIO NPP")
    field(MMIS, "$(MOTOR=$(P)).MISS NPP")
    field(MRES, "$(MOTOR=$(P)).MRES NPP")
}
